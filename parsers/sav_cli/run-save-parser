#!/usr/bin/env bash
set -euo pipefail

SAVE_GAMES_DIR="${1:-}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_BIN="${SAV_CLI_PYTHON:-$SCRIPT_DIR/.venv/bin/python}"

if [[ -z "$SAVE_GAMES_DIR" ]]; then
  echo '{"players":[],"guilds":[],"pals":[],"inventory":[],"map":null,"error":"missing SaveGames directory"}'
  exit 1
fi

if [[ ! -x "$PYTHON_BIN" ]]; then
  if command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN="$(command -v python3)"
  else
    echo '{"players":[],"guilds":[],"pals":[],"inventory":[],"map":null,"error":"python3 not found"}'
    exit 1
  fi
fi

LEVEL_FILE="$(find "$SAVE_GAMES_DIR" -name Level.sav -type f -print -quit 2>/dev/null || true)"
if [[ -z "$LEVEL_FILE" ]]; then
  echo '{"players":[],"guilds":[],"pals":[],"inventory":[],"map":null,"error":"Level.sav not found"}'
  exit 1
fi

TMP_JSON="$(mktemp)"
trap 'rm -f "$TMP_JSON"' EXIT

"$PYTHON_BIN" "$SCRIPT_DIR/sav_cli.py" -f "$LEVEL_FILE" -o "$TMP_JSON" >/dev/null
cat "$TMP_JSON"
