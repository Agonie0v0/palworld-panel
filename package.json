{
  "name": "palworld-oneclick-panel",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-architecture Palworld server deployment and management panel.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "check": "node --check src/server.js && node --check src/upstream-compat.js",
    "test": "node --test test/*.test.js",
    "build:web": "pnpm --dir upstream-web build",
    "test:web": "pnpm --dir upstream-web test"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "cron-parser": "^4.9.0"
  }
}
